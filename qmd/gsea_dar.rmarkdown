### Wikipathways



```{r gsea_d_wk}
set.seed(2409)
gsea$d$wk <- lapply(ranks_d, \(x){
    fgseaMultilevel(wk_by_id, x) %>%
        as_tibble() %>%
        dplyr::rename(FDR = padj, Pathway = pathway) %>%
        dplyr::arrange(pval) %>%
        mutate(
            Edge = vapply(leadingEdge, length, numeric(1)),
            Direction = case_when(
                sign(ES) == 1 ~ "Up",
                sign(ES) == -1 ~ "Down",
                sign(ES) == 0 ~ "None"
            ),
            bonf.padj = p.adjust(pval, "bonferroni"),
            Sig = FDR < 0.05,
        )
})
```



